# ============================================================
# Football AI Hub Video Service - env
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# Server
PORT=3000
RENDER_TIMEOUT_MS=300000

# Cloudflare R2 (free 10GB) - REQUIRED for serving rendered MP4s
# Get from: https://dash.cloudflare.com -> R2 -> Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=football-ai-hub-assets
# After bucket created, enable Public Bucket in R2 settings - copy the pub URL here
R2_PUBLIC_URL=https://pub-REPLACE_ME.r2.dev

# Optional shared secret. If set, render service rejects requests without matching X-API-Key header.
# Generate with: openssl rand -hex 32
SERVICE_API_KEY=
